<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mindspark_robot</name>
  <version>1.0.0</version>
 <description>
    MindSpark ROS2 Training Module: A hands-on educational package
    covering ROS2 fundamentals, publisher-subscriber communication,
    computer vision, camera integration, YOLO object detection,
    and custom green-ball detection.
  </description>
  <maintainer email="ilmiariffin@gmail.com">ilmi</maintainer>
  <license>AGPL-3.0-or-later</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
